# Koneksi database (Supabase / PostgreSQL)
# Ambil dari Supabase -> Project Settings -> Database -> Connection String (URI, mode: Transaction/Session)
DATABASE_URL=postgresql://postgres.ntqukrqkadojyhfoluye:nafisspalanzaniindiarto@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres

# Secret untuk JWT (ganti dengan string acak yang panjang & rahasia)
JWT_SECRET=ganti_dengan_secret_key_yang_sangat_rahasia_dan_panjang
JWT_EXPIRES_IN=1d

# Port server (opsional, Vercel akan override otomatis)
PORT=3000

# Node environment
NODE_ENV=development
